{
  "name": "jonleibham",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jonleibham/portfolio-site",
    "build": "npm run build -w @jonleibham/portfolio-site",
    "preview": "npm run preview -w @jonleibham/portfolio-site",
    "storybook": "npm run storybook -w @jonleibham/storybook",
    "build-storybook": "npm run build-storybook -w @jonleibham/storybook",
    "build:design": "npm run build:design -w @jonleibham/design-system",
    "measure:design": "npm run measure:design -w @jonleibham/design-system",
    "test": "npm run test --workspaces --if-present",
    "typecheck:dev": "npm run typecheck:dev --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.5.6",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "volta": {
    "node": "24.12.0"
  }
}
